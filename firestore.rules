rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's ledger lives at ledgers/{uid}. A signed-in user may
    // read and write ONLY their own document — nobody can touch another
    // account's data, and unauthenticated requests are rejected outright.
    match /ledgers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
